## Special files (Tokyo Night Storm-Neon)
# DIR     = #7aa2f7 (122;162;247) — matches prompt user
# LINK    = #41a6b5 (65;166;181)  — matches prompt host
# EXEC    = #9ece6a (158;206;106) — matches prompt dir
# ORPHAN  = #ff007c (255;0;124) on #1f2335 (31;35;53) — matches prompt exit

NORMAL 00;38;2;192;202;245
RESET 0
DIR 01;38;2;122;162;247
LINK 00;38;2;65;166;181
MULTIHARDLINK 00
FIFO 48;2;31;35;53;38;2;224;175;104;01
SOCK 48;2;31;35;53;38;2;224;175;104;01
DOOR 48;2;31;35;53;38;2;224;175;104;01
BLK 48;2;31;35;53;38;2;120;124;153;01
CHR 48;2;31;35;53;38;2;120;124;153;01
ORPHAN 48;2;31;35;53;38;2;255;0;124;01
MISSING 48;2;31;35;53;38;2;255;0;124;01
SETUID 48;2;219;75;75;38;2;26;27;38
SETGID 48;2;224;175;104;38;2;26;27;38
CAPABILITY 48;2;219;75;75;38;2;26;27;38
STICKY_OTHER_WRITABLE 48;2;158;206;106;38;2;26;27;38
OTHER_WRITABLE 48;2;31;35;53;38;2;122;162;247
STICKY 48;2;122;162;247;38;2;26;27;38
EXEC 00;38;2;158;206;106

