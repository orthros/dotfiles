theme "dotfiles-theme"

themes {
    dotfiles-theme {
        fg "@fg@"
        bg "@surface@"
        black "@bg@"
        red "@urgent@"
        green "@aqua@"
        yellow "@amber@"
        blue "@accent@"
        magenta "@lavender@"
        cyan "@teal@"
        white "@fg@"
        orange "@orange@"
    }
}
