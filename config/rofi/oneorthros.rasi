@import "theme.rasi"

* {
  spacing: 0;
  background-color: transparent;
  font: @font-name;
  text-color: @text;
}

window {
  transparency: "real";
  fullscreen: false;
  background-color: @bg-window;
  border: 2px;
  border-color: @blue;
  border-radius: 10px;
}

mainbox {
  spacing: 20px;
  margin: 0%;
  padding: 24px 24px;
  border: 0px;
}

inputbar {
  margin: 0px 0px 12px 0px;
  children: [prompt, textbox-prompt-colon, entry, case-indicator];
}

prompt {
  text-color: @blue;
}

textbox-prompt-colon {
  expand: false;
  str: ":";
  text-color: @text-alt;
}

entry {
  margin: 0px 10px;
}

listview {
  spacing: 6px;
  dynamic: true;
  layout: vertical;
  scrollbar: false;
}

element {
  padding: 8px 12px;
  text-color: @text-alt;
  highlight: bold #9ece6a;
  border-radius: 6px;
}

element selected {
  background-color: @emphasis;
  text-color: @text;
}

element urgent, element selected urgent {
  text-color: @red;
}

element active, element selected active {
  text-color: @purple;
}

message {
  padding: 10px;
  border-radius: 6px;
  background-color: @emphasis;
  border: 1px;
  border-color: @cyan;
}

button selected {
  padding: 6px;
  border-radius: 6px;
  background-color: @emphasis;
}
