/* Auto-generated by modules/theme (preset: @preset@) */
* {
  black:      @bg@;
  red:        @urgent@;
  green:      @aqua@;
  yellow:     @amber@;
  blue:       @accent@;
  mangenta:   @lavender@;
  cyan:       @teal@;
  purple:     @purple@;
  emphasis:   @surfaceHover@;
  text:       @fg@;
  text-alt:   @fgMuted@;
  fg:         @fg@;
  bg:         @surface@;
  bg-window:  @surface@ee;
  font-name:  "@fontFamily@ 14";
}
