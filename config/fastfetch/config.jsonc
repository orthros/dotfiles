{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "color": {
      "1": "@accentAnsi@",
      "2": "@tealAnsi@",
      "3": "@lavenderAnsi@"
    }
  },
  "display": {
    "color": {
      "keys": "@accentAnsi@",
      "title": "@cyanAnsi@",
      "output": "@fgAnsi@",
      "separator": "@slateAnsi@"
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "font",
    "cursor",
    "terminal",
    "terminalfont",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "localip",
    "battery",
    "poweradapter",
    "locale",
    "break",
    "colors"
  ]
}
