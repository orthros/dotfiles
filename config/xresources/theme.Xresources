!! Auto-generated by modules/theme (preset: @preset@)
*background:            @bg@
URxvt*background:       [90]@bg@
*foreground:            @fg@
*fadeColor:             @surface@
*cursorColor:           @accent@
*pointerColorBackground:@surfaceHover@
*pointerColorForeground:@fg@

!! black dark/light
*color0:                @bg@
*color8:                @slate@

!! red dark/light
*color1:                @error@
*color9:                @urgent@

!! green dark/light
*color2:                @green@
*color10:               @aqua@

!! yellow dark/light
*color3:                @amber@
*color11:               @orange@

!! blue dark/light
*color4:                @accent@
*color12:               @accent@

!! magenta dark/light
*color5:                @lavender@
*color13:               @purple@

!! cyan dark/light
*color6:                @cyan@
*color14:               @teal@

!! white dark/light
*color7:                @fgMuted@
*color15:               @fg@

! -- Fonts -- !
URxvt.font: xft:@fontFamily@:pixelsize=27:antialias=true:hinting=full,xft:Symbola:pixelsize=19:antialias=true:hinting=full
URxvt.boldFont: xft:@fontFamily@:style=bold:pixelsize=27:antialias=true:hinting=full,xft:Symbola:pixelsize=19:antialias=true:hinting=full
