#!/usr/bin/env zsh

# Get the git utilities
source "$dotfile_config_path/zsh/git-utils.sh"

# Gcloud Active Project Get
if command -v gcloud &>/dev/null; then
  alias gcloudproj="gcloud config list --format 'value(core.project)' 2>/dev/null"

  cloudproj() {
    gcloud config list --format 'value(core.project)' 2>/dev/null
  }
fi

# cdg is used to cd to the root of a jj or git repository (if you're in one)
function cdg() {
  if jj root &>/dev/null; then
    cd "$(jj root)" || return
  elif in_git_dir; then
    cd "$(git rev-parse --show-toplevel)" || return
  else
    echo "Run cdg in a jj or git repository"
  fi
}

function git_branch_search() {
  local selected_line
  if jj root &>/dev/null; then
    # Disable check as LBUFFER is provided to us by ZSH
    # shellcheck disable=2153
    selected_line=$(jj bookmark list --no-pager -T 'if(!self.remote(), self.name() ++ "\n")' | fzf --query "${LBUFFER:-}" --prompt="jj bookmark > " --preview 'jj log --color=always -r "ancestors({}, 5)"')
    if [ -n "$selected_line" ]; then
      jj new "$selected_line"
      if zle; then
        BUFFER=""
        zle accept-line
      fi
    fi
    return
  fi
  # Check for git repository
  if ! in_git_dir; then
    echo "Run git_branch_search in a jj or git repository"
    return
  fi
  # Disable check as LBUFFER is provided to us by ZSH
  # shellcheck disable=2153
  selected_line=$(git branch --format="%(refname:short)" | fzf --query "${LBUFFER:-}" --prompt="git branch > " --preview 'git log --oneline --color=always -n 10 {}')
  if [ -n "$selected_line" ]; then
    git checkout "$selected_line"
    if zle; then
      BUFFER=""
      zle accept-line
    fi
  fi
}
zle -N git_branch_search
bindkey '^B' git_branch_search
alias gcb="git_branch_search"

function ghq_cd() {
  local selected_line
  # Disable check as LBUFFER is provided to us by ZSH
  # shellcheck disable=2153
  selected_line=$(ghq list | fzf --query "${LBUFFER:-}" --prompt="ghq > " --preview "glow -s dark \$(ghq root)/{}/README.md 2>/dev/null || ls -la \$(ghq root)/{}")
  if [ -n "$selected_line" ]; then
    cd "$(ghq root)/${selected_line}" || return
    if zle; then
      # Disable check as BUFFER is set for us by ZSH
      # shellcheck disable=2034
      BUFFER=""
      zle accept-line
    fi
  fi
}
zle -N ghq_cd
bindkey '^]' ghq_cd

function ghq_update_all() {
  # Get each tracked repository
  for repo in $(ghq list); do
    # Update it
    ghq get -u "${repo}"
  done
}

# Special tmux alias to cd to the root of the tmux session
function cdt() {
  cd "$(tmux display -p '#{session_path}')" || return
}

# fzf configuration (backed by fd; colors provided by ~/.config/theme/colors.sh
# when managed by modules/theme, falling back to cherry-blossom defaults)
export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git --exclude .jj'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git --exclude .jj'
if [[ -z "${DOTFILES_THEME_PRESET:-}" ]]; then
  export FZF_DEFAULT_OPTS="
    --height 100%
    --tmux 80%,60%
    --layout=default
    --border=rounded
    --info=inline-right
    --color=bg+:#233440,fg:#c7afb7,fg+:#f2dfe3,hl:#e87a90,hl+:#9ad1ca
    --color=prompt:#e87a90,pointer:#ff4d79,marker:#7ec4b6,border:#6ea39e,header:#5a6b75
    --bind 'ctrl-/:toggle-preview,ctrl-u:preview-half-page-up,ctrl-d:preview-half-page-down'
    --bind 'ctrl-y:execute-silent(echo -n {+} | (wl-copy 2>/dev/null || xclip -selection clipboard 2>/dev/null || pbcopy 2>/dev/null))+abort'
  "
fi
export FZF_CTRL_T_OPTS="
  --preview 'if [[ -d {} ]]; then dust -d 1 {}; elif [[ {} == *.md ]]; then glow -s dark {}; else head -n 200 {}; fi'
  --bind 'ctrl-e:become(nvim {+})'
"
export FZF_ALT_C_OPTS="--preview 'dust -d 1 {}'"
export FZF_CTRL_R_OPTS="
  --preview 'echo {}'
  --preview-window down:3:hidden:wrap
  --bind 'ctrl-y:execute-silent(echo -n {2..} | (wl-copy 2>/dev/null || xclip -selection clipboard 2>/dev/null || pbcopy 2>/dev/null))+abort'
"

if command -v fzf &>/dev/null; then
  eval "$(fzf --zsh)"
fi
