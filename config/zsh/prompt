function _prompt_sgr_fg() {
	local c="$1"
	if [[ "$c" == \#[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F] ]]; then
		REPLY="38;2;$(( 16#${c[2,3]} ));$(( 16#${c[4,5]} ));$(( 16#${c[6,7]} ))"
	elif [[ "$c" == <-> ]]; then
		REPLY="38;5;${c}"
	else
		REPLY="38;5;244"
	fi
}

function _prompt_sgr_bg() {
	local c="$1"
	if [[ "$c" == \#[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F] ]]; then
		REPLY="48;2;$(( 16#${c[2,3]} ));$(( 16#${c[4,5]} ));$(( 16#${c[6,7]} ))"
	elif [[ "$c" == <-> ]]; then
		REPLY="48;5;${c}"
	else
		REPLY="48;5;235"
	fi
}

function _prompt_apply_ls_colors() {
	local REPLY
	_prompt_sgr_fg "${ZSH_PROMPT_COLORS[ls_norm]}"
	local sgr_norm="00;${REPLY}"

	_prompt_sgr_fg "${ZSH_PROMPT_COLORS[user]}"
	local fg_dir="${REPLY}"
	local bg_dir="${REPLY/#38;/48;}"
	local sgr_dir="01;${fg_dir}"
	if [[ "${ZSH_PROMPT_THEME}" == "classic" ]]; then
		sgr_dir="00;${fg_dir}"
	fi

	_prompt_sgr_fg "${ZSH_PROMPT_COLORS[host]}"
	local sgr_link="00;${REPLY}"

	_prompt_sgr_fg "${ZSH_PROMPT_COLORS[dir]}"
	local fg_exec="${REPLY}"
	local bg_exec="${REPLY/#38;/48;}"
	local sgr_exec="00;${fg_exec}"

	_prompt_sgr_fg "${ZSH_PROMPT_COLORS[ls_archive]}"
	local sgr_arc="00;${REPLY}"

	_prompt_sgr_fg "${ZSH_PROMPT_COLORS[ls_image]}"
	local fg_img="${REPLY}"
	local bg_img="${REPLY/#38;/48;}"
	local sgr_img="00;${fg_img}"

	_prompt_sgr_fg "${ZSH_PROMPT_COLORS[ls_media]}"
	local sgr_med="00;${REPLY}"

	_prompt_sgr_fg "${ZSH_PROMPT_COLORS[ls_doc]}"
	local fg_doc="${REPLY}"
	local sgr_doc="00;${fg_doc}"

	_prompt_sgr_fg "${ZSH_PROMPT_COLORS[ls_dim]}"
	local sgr_dim="00;${REPLY}"

	local sgr_fifo sgr_blk sgr_orphan sgr_su sgr_sg sgr_tw sgr_ow sgr_st
	if [[ "${ZSH_PROMPT_THEME}" == "classic" ]]; then
		sgr_fifo="48;5;230;38;5;136;01"
		sgr_blk="48;5;230;38;5;244;01"
		sgr_orphan="48;5;235;38;5;160"
		sgr_su="48;5;160;38;5;230"
		sgr_sg="48;5;136;38;5;230"
		sgr_tw="48;5;64;38;5;230"
		sgr_ow="48;5;235;38;5;33"
		sgr_st="48;5;33;38;5;230"
	else
		local bg_surface="48;2;31;35;53"
		local fg_dark="38;2;26;27;38"
		_prompt_sgr_fg "${ZSH_PROMPT_COLORS[exit]}"
		local fg_exit="${REPLY}"
		_prompt_sgr_bg "${ZSH_PROMPT_COLORS[err]}"
		local bg_err="${REPLY}"

		sgr_fifo="${bg_surface};${fg_img};01"
		sgr_blk="${bg_surface};${fg_doc};01"
		sgr_orphan="${bg_surface};${fg_exit};01"
		sgr_su="${bg_err};${fg_dark}"
		sgr_sg="${bg_img};${fg_dark}"
		sgr_tw="${bg_exec};${fg_dark}"
		sgr_ow="${bg_surface};${fg_dir}"
		sgr_st="${bg_dir};${fg_dark}"
	fi

	local -a entries=(
		"rs=0"
		"no=${sgr_norm}"
		"di=${sgr_dir}"
		"ln=${sgr_link}"
		"mh=00"
		"pi=${sgr_fifo}"
		"so=${sgr_fifo}"
		"do=${sgr_fifo}"
		"bd=${sgr_blk}"
		"cd=${sgr_blk}"
		"or=${sgr_orphan}"
		"mi=${sgr_orphan}"
		"su=${sgr_su}"
		"sg=${sgr_sg}"
		"ca=30;41"
		"tw=${sgr_tw}"
		"ow=${sgr_ow}"
		"st=${sgr_st}"
		"ex=${sgr_exec}"
	)

	local ext
	for ext in .tar .tgz .arj .taz .lzh .lzma .tlz .txz .zip .z .Z .dz .gz .lz .xz .bz2 .bz .tbz .tbz2 .tz .zst .tzst .deb .rpm .jar .rar .ace .zoo .cpio .7z .rz .apk .gem .whl .crate; do
		entries+=("*${ext}=${sgr_arc}")
	done

	for ext in .jpg .JPG .jpeg .gif .bmp .pbm .pgm .ppm .tga .xbm .xpm .tif .tiff .png .PNG .svg .svgz .webp .mng .pcx .dl .xcf .xwd .yuv .cgm .emf .eps .CR2 .ico; do
		entries+=("*${ext}=${sgr_img}")
	done

	for ext in .tex .rdf .owl .n3 .ttl .nt .torrent .xml .nfo .md .ini .yml .yaml .toml .json .kdl .nix .rs .lua .py .cfg .conf .h .hpp .c .cpp .cxx .cc .objc .sqlite .go .sql .csv; do
		entries+=("*${ext}=${sgr_doc}")
	done
	for ext in Makefile Justfile Rakefile Dockerfile build.xml rc 1 README README.txt readme.txt README.markdown; do
		entries+=("*${ext}=${sgr_doc}")
	done

	for ext in .log .bak .aux .lof .lol .lot .out .toc .bbl .blg .part .incomplete .swp .tmp .temp .o .pyc .class .cache .lock; do
		entries+=("*${ext}=${sgr_dim}")
	done
	entries+=("*~=${sgr_dim}" "*#=${sgr_dim}")

	for ext in .aac .au .flac .mid .midi .mka .mp3 .mpc .ogg .opus .ra .wav .m4a .axa .oga .spx .xspf .mov .MOV .mpg .mpeg .m2v .mkv .ogm .mp4 .m4v .mp4v .vob .qt .nuv .wmv .asf .rm .rmvb .flc .avi .fli .flv .gl .m2ts .divx .webm .axv .anx .ogv .ogx; do
		entries+=("*${ext}=${sgr_med}")
	done

	export LS_COLORS="${(j.:.)entries}:"
	export ZLS_COLORS="${LS_COLORS}"
	export LSCOLORS="ExGxFxdaCxDaDahbadacec"
}


function prompt_git() {
	local s='';
	local branchName='';
	local c_on="${ZSH_PROMPT_COLORS[on]:-white}"
	local c_branch="${ZSH_PROMPT_COLORS[branch]:-blue}"
	local c_status="${ZSH_PROMPT_COLORS[status]:-61}"

	# Check if the current directory is in a Git repository.
	if [ "$(git rev-parse --is-inside-work-tree &>/dev/null; echo "${?}")" = '0' ]; then

		# check if the current directory is in .git before running git checks
		if [ "$(git rev-parse --is-inside-git-dir 2> /dev/null)" = 'false' ]; then

      # Check if SIMPLE_GIT_PROMPT is set
      if [[ ${SIMPLE_GIT_PROMPT+x} ]]; then
        # There are some large git repositories where calculating if 
        # there are any untracked files is an expensive operation O(second)
        # which causes prompt redraws to be very sluggish. Having a toggle
        # to simply show we are in a git directory will speed things up
        echo " %F{${c_status}}Ξ%F{reset}"
        return
      fi

			if [[ -O "$(git rev-parse --show-toplevel)/.git/index" ]]; then
				git update-index --really-refresh -q &> /dev/null;
			fi;

			# Check for uncommitted changes in the index.
			if ! git diff --quiet --ignore-submodules --cached; then
				s+='+';
			fi;

			# Check for unstaged changes.
			if ! git diff-files --quiet --ignore-submodules --; then
				s+='!';
			fi;

			# Check for untracked files.
			if [ -n "$(git ls-files --others --exclude-standard)" ]; then
				s+='?';
			fi;

			# Check for stashed files.
			if git rev-parse --verify refs/stash &>/dev/null; then
				s+='$';
			fi;

		fi;

		# Get the short symbolic ref.
		# If HEAD isn’t a symbolic ref, get the short SHA for the latest commit
		# Otherwise, just give up.
		branchName="$(git symbolic-ref --quiet --short HEAD 2> /dev/null || \
			git rev-parse --short HEAD 2> /dev/null || \
			echo '(unknown)')";

		[ -n "${s}" ] && s=" [${s}]";

		echo " %F{${c_on}}on %F{${c_branch}}${branchName}%F{reset}%F{${c_status}}${s}%F{reset}";
	else
		return;
	fi;
}


function gcloudmode() {
  	if ! command -v gcloud &>/dev/null; then
		  return
  	fi

	if [ -z ${SHOW_GCLOUD_PROMPT+x} ]; then
		SHOW_GCLOUD_PROMPT="1"
	else
		unset SHOW_GCLOUD_PROMPT
	fi
}

function prompt_gcloud() {
  	if ! command -v gcloud &>/dev/null; then
		  return
  	fi

	if [ -z ${SHOW_GCLOUD_PROMPT+x} ]; then
		return
	else
		local cloud_icon="☁️ "
      	local project_name=$(gcloud config list --format 'value(core.project)' 2>/dev/null)
		echo "${cloud_icon}${project_name}${cloud_icon}"
	fi
}

function prompt_ssh() {
    local symbol="Φ"
    local c_ssh="${ZSH_PROMPT_COLORS[ssh]:-163}"
    if [ -z ${SSH_CONNECTION+x} ]; then
        return
    else
        echo "%F{${c_ssh}}${symbol}%F{reset} "
    fi
}

function _prompt_build_strings() {
	local cloud_icon="☁️ "

	local user_host="%F{${ZSH_PROMPT_COLORS[user]}}%n%F{reset}"
	local user_hostname="%F{${ZSH_PROMPT_COLORS[host]}}%m%F{reset}"
	local conn_at="%F{${ZSH_PROMPT_COLORS[conn]}}at%F{reset}"
	local conn_in="%F{${ZSH_PROMPT_COLORS[conn]}}in%F{reset}"
	local current_dir="%F{${ZSH_PROMPT_COLORS[dir]}}%~%F{reset}"

	local last_command="%F{${ZSH_PROMPT_COLORS[exit]}}%(?..[%?] )%F{reset}"
	local command_prompt="%F{${ZSH_PROMPT_COLORS[sym]}}∮ %F{reset}"

	local git_info='$(prompt_git)'
	local ssh_prompt='$(prompt_ssh)'

	local vm_host=""
	if [[ -f /proc/cpuinfo ]] && grep -q "^flags.* hypervisor" /proc/cpuinfo && [[ ! -d "/mnt/c/Windows" ]]; then
		vm_host=$cloud_icon
	fi

	local cloud_prompt='$(prompt_gcloud)'

	RPROMPT="${last_command}"
	if [[ -n "${gcertprompt:-}" ]]; then
		RPROMPT="${RPROMPT} ${gcertprompt}"
	fi

	PROMPT="%B
${cloud_prompt}${user_host} ${conn_at} ${ssh_prompt}${vm_host}${user_hostname} ${conn_in} ${current_dir}${git_info}
${command_prompt}%b"

	_prompt_apply_ls_colors
}

function _prompt_render_sample() {
	local target_theme="$1"
	local saved_theme="${ZSH_PROMPT_THEME}"
	local -A saved_colors
	saved_colors=("${(@kv)ZSH_PROMPT_COLORS}")

	if ! _prompt_load_palette "${target_theme}"; then
		return 1
	fi

	local c_user="${ZSH_PROMPT_COLORS[user]}"
	local c_host="${ZSH_PROMPT_COLORS[host]}"
	local c_ssh="${ZSH_PROMPT_COLORS[ssh]}"
	local c_dir="${ZSH_PROMPT_COLORS[dir]}"
	local c_branch="${ZSH_PROMPT_COLORS[branch]}"
	local c_status="${ZSH_PROMPT_COLORS[status]}"
	local c_conn="${ZSH_PROMPT_COLORS[conn]}"
	local c_on="${ZSH_PROMPT_COLORS[on]}"
	local c_sym="${ZSH_PROMPT_COLORS[sym]}"
	local c_exit="${ZSH_PROMPT_COLORS[exit]}"
	local c_ok="${ZSH_PROMPT_COLORS[ok]}"
	local c_err="${ZSH_PROMPT_COLORS[err]}"
	local c_arc="${ZSH_PROMPT_COLORS[ls_archive]}"
	local c_img="${ZSH_PROMPT_COLORS[ls_image]}"
	local c_med="${ZSH_PROMPT_COLORS[ls_media]}"
	local c_doc="${ZSH_PROMPT_COLORS[ls_doc]}"
	local c_dim="${ZSH_PROMPT_COLORS[ls_dim]}"

	local active_marker=""
	if [[ "${ZSH_PROMPT_THEME}" == "${saved_theme}" ]]; then
		active_marker=" %F{#9ece6a}(active)%f"
	fi

	print -P "%B%F{#c0caf5}━━━ ${ZSH_PROMPT_THEME}${active_marker} %F{#565f89}— ${ZSH_PROMPT_THEME_DESC[${ZSH_PROMPT_THEME}]}%f%b"
	print -P "  %F{#565f89}Swatches:%f %B%F{${c_user}}██ user/di%f  %F{${c_host}}██ host/ln%f  %F{${c_ssh}}██ ssh%f  %F{${c_dir}}██ dir/ex%f  %F{${c_branch}}██ branch%f  %F{${c_status}}██ status%f  %F{${c_exit}}██ exit%f%b"
	echo ""

	local left_a="%B%F{${c_user}}colnnelson%f %F{${c_conn}}at%f %F{${c_host}}alecto%f %F{${c_conn}}in%f %F{${c_dir}}~/Development/src/nix-config%f %F{${c_on}}on%f %F{${c_branch}}main%f%F{${c_status}} [!+]%f%b"
	local right_a="%F{${c_conn}}[%f %B%F{${c_ok}}Ω%f%b %F{${c_conn}}]%f"
	print -P "  ${left_a}        ${right_a}"
	print -P "  %B%F{${c_sym}}∮ %f%b%F{#a9b1d6}ls -F%f"
	print -P "  %B%F{${c_user}}dotfiles%f%b/  %F{${c_host}}result%f@  %F{${c_dir}}build.sh%f*  %F{${c_arc}}pkg.tar.zst%f  %F{${c_img}}wall.png%f  %F{${c_med}}demo.mp4%f  %F{${c_doc}}README.md%f  %F{${c_dim}}build.log%f  %K{#1f2335}%B%F{${c_exit}}broken%f%b%k@"
	echo ""

	local left_b="%B%F{${c_user}}colnnelson%f %F{${c_conn}}at%f %F{${c_ssh}}Φ%f ☁️ %F{${c_host}}cytherea%f %F{${c_conn}}in%f %F{${c_dir}}~/fuchsia%f %F{${c_on}}on%f %F{${c_branch}}fx-branch%f%F{${c_status}} [?]%f%b"
	local right_b="%F{${c_exit}}[130]%f %F{${c_conn}}[%f %B%F{${c_err}}Ω%f%b %F{${c_conn}}]%f"
	print -P "  ${left_b}            ${right_b}"
	print -P "  %B%F{${c_sym}}∮ %f%b"
	echo ""

	ZSH_PROMPT_THEME="${saved_theme}"
	ZSH_PROMPT_COLORS=("${(@kv)saved_colors}")
}

function prompt_theme() {
	local quiet=0
	local arg="${1:-}"

	if [[ "${arg}" == "-q" || "${arg}" == "--quiet" ]]; then
		quiet=1
		shift
		arg="${1:-}"
	fi

	case "${arg}" in
		-h|--help)
			echo "Usage: prompt_theme [theme | --list | --preview [theme]]"
			echo ""
			echo "Themes:"
			local t
			for t in "${ZSH_PROMPT_THEME_ORDER[@]}"; do
				printf "  %-12s %s\n" "${t}" "${ZSH_PROMPT_THEME_DESC[${t}]}"
			done
			return 0
			;;
		-l|--list)
			local saved_theme="${ZSH_PROMPT_THEME}"
			local -A saved_colors
			saved_colors=("${(@kv)ZSH_PROMPT_COLORS}")
			local t marker swatch
			for t in "${ZSH_PROMPT_THEME_ORDER[@]}"; do
				_prompt_load_palette "${t}"
				if [[ "${t}" == "${saved_theme}" ]]; then
					marker="%F{#9ece6a}*%f"
				else
					marker="%F{#565f89}·%f"
				fi
				swatch="%B%F{${ZSH_PROMPT_COLORS[user]}}██%f%F{${ZSH_PROMPT_COLORS[host]}}██%f%F{${ZSH_PROMPT_COLORS[ssh]}}██%f%F{${ZSH_PROMPT_COLORS[dir]}}██%f%F{${ZSH_PROMPT_COLORS[branch]}}██%f%F{${ZSH_PROMPT_COLORS[status]}}██%f%F{${ZSH_PROMPT_COLORS[exit]}}██%f%b"
				print -P " ${marker} ${swatch}  %B$(printf '%-12s' "${t}")%b %F{#565f89}${ZSH_PROMPT_THEME_DESC[${t}]}%f"
			done
			ZSH_PROMPT_THEME="${saved_theme}"
			ZSH_PROMPT_COLORS=("${(@kv)saved_colors}")
			return 0
			;;
		-p|--preview)
			shift
			if [[ -n "${1:-}" ]]; then
				_prompt_render_sample "$1"
			else
				local t
				for t in "${ZSH_PROMPT_THEME_ORDER[@]}"; do
					_prompt_render_sample "${t}"
				done
			fi
			return 0
			;;
		"")
			if command -v fzf &>/dev/null && [[ -t 0 && -t 1 ]]; then
				local selected
				selected=$(
					prompt_theme --list | fzf \
						--ansi \
						--no-sort \
						--prompt="Prompt Theme > " \
						--header="Current: ${ZSH_PROMPT_THEME} (Enter to apply, Esc to cancel)" \
						--preview="zsh -c 'source ${(q)ZSH_PROMPT_SCRIPT_PATH} && _prompt_render_sample {3}'" \
						--preview-window="down:12:wrap" | awk '{print $3}'
				)
				if [[ -n "${selected}" ]]; then
					prompt_theme "${selected}"
				fi
				return 0
			else
				prompt_theme --list
				return 0
			fi
			;;
	esac

	if ! _prompt_load_palette "${arg}"; then
		echo "Unknown prompt theme: ${arg}" >&2
		echo "Available themes: ${ZSH_PROMPT_THEME_ORDER[*]}" >&2
		return 1
	fi

	_prompt_build_strings

	if (( ! quiet )); then
		mkdir -p "${ZSH_PROMPT_THEME_STATE_FILE:h}" 2>/dev/null
		printf '%s\n' "${ZSH_PROMPT_THEME}" > "${ZSH_PROMPT_THEME_STATE_FILE}" 2>/dev/null || true
		print -P "%F{#565f89}Switched prompt & ls theme to%f %B%F{${ZSH_PROMPT_COLORS[user]}}${ZSH_PROMPT_THEME}%f%b"
	fi
}

function _prompt_theme() {
	local -a themes
	themes=(
		'cherry-blossom:Cherry Blossom (Sakura Night — sakura pink, seafoam, midnight pine)'
		'faithful:Tokyo Night Faithful (1:1 hue mapping to tokyonight-night)'
		'cyber-aqua:Tokyo Night Cyber Aqua (aqua mint dir, lavender branch, amber status)'
		'storm:Tokyo Night Storm (subdued mid-tones, amber exit code)'
		'storm-neon:Tokyo Night Storm with neon magenta (#ff007c) exit code'
		'sunset:Tokyo Night Shibuya Sunset (warm orange #ff9e64 SSH & git dirty accents)'
		'moon:Tokyo Night Moon (periwinkle, ice cyan, pistachio, violet)'
		'classic:Classic (original 256-color cube + ANSI palette)'
		'--list:List available prompt themes'
		'--preview:Preview all prompt themes in terminal'
	)
	_describe -t themes 'prompt theme' themes
}

if (( $+functions[compdef] )); then
	compdef _prompt_theme prompt_theme
fi

# Load persisted theme (or default to DOTFILES_THEME_PRESET / cherry-blossom) on shell startup
if [[ -z "${ZSH_PROMPT_THEME}" ]]; then
	if [[ -r "${ZSH_PROMPT_THEME_STATE_FILE}" ]]; then
		read -r ZSH_PROMPT_THEME < "${ZSH_PROMPT_THEME_STATE_FILE}"
	fi
	if ! _prompt_load_palette "${ZSH_PROMPT_THEME:-${DOTFILES_THEME_PRESET:-cherry-blossom}}"; then
		_prompt_load_palette "${DOTFILES_THEME_PRESET:-cherry-blossom}"
	fi
fi

_prompt_build_strings
